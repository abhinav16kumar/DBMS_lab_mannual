FROM Sales_1NF;

INSERT INTO Sales
SELECT DISTINCT SaleID, CustomerID, Salesperson
FROM Sales_1NF;

INSERT INTO Products
SELECT DISTINCT ProductID, ProductName, Price
FROM Sales_1NF;

INSERT INTO SaleItems
SELECT SaleID, ProductID
FROM Sales_1NF;

SELECT * FROM Customers;
SELECT * FROM Sales;
SELECT * FROM Products;
SELECT * FROM SaleItems;


SELECT
    s.SaleID,
    c.CustomerID,
    c.CustomerName,
    p.ProductID,
    p.ProductName,
    p.Price,
    s.Salesperson
FROM Sales s
JOIN Customers c
    ON s.CustomerID = c.CustomerID
JOIN SaleItems si
    ON s.SaleID = si.SaleID
JOIN Products p
    ON si.ProductID = p.ProductID
ORDER BY s.SaleID, p.ProductID;
